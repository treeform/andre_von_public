   "description": "A cozy BitWorld garden dinner game where players grow food, collect vegetables, and gather in the evening. Every gnome is played by the game itself from the soul file its player uploads.",
   "config_schema": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": [
     "tokens"
    ],
    "properties": {
     "seed": {
      "type": "integer",
      "default": 4731713,
      "minimum": 0,
      "description": "Random seed. The hosted default 4731713 is an unpinned sentinel: the game draws a fresh seed. Pin any other integer to freeze the village RNG."
     },
     "tokens": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 0
      },
      "maxItems": 9,
      "minItems": 2,
      "description": "One connection token per player seat, indexed by seat. 2-9 seats; empty houses stay closed."
     },
     "maxDays": {
      "type": "integer",
      "default": 0,
      "minimum": 0,
      "description": "Game length in days, score screens included; overrides maxTicks. The league plays 7. The game refuses a length past the 40-minute hosted deadline."
     },
     "players": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "name"
       ],
       "properties": {
        "name": {
         "type": "string",
         "minLength": 1
        }
       },
       "additionalProperties": false
      },
      "maxItems": 9,
      "minItems": 2,
      "description": "Per-seat display names, 2-9 seats. Hosted dispatch fills each name with the policy or player behind the seat; the score panel shows it instead of player_N."
     },
     "maxGames": {
      "type": "integer",
      "default": 0,
      "minimum": 0,
      "description": "Maximum fresh games before shutdown, where 0 means no game limit."
     },
     "maxTicks": {
      "type": "integer",
      "default": 0,
      "minimum": 0,
      "description": "Maximum simulation ticks before starting a fresh game, where 0 means no tick limit."
     },
     "mockReply": {
      "type": "string",
      "default": "",
      "description": "Offline stand-in for the model: when set, every decision is this literal reply and no model is called. Used by the certification fixture and local smoke runs only; hosted variants leave it unset so each soul's model is really called."
     },
     "daySeconds": {
      "type": "integer",
      "default": 180,
      "maximum": 600,
      "minimum": 30,
      "description": "Real seconds per in-game day (9am to 9pm), before the 10-second score screen. 180 is the league clock: four game hours per real minute."
     },
     "soulTimeoutSeconds": {
      "type": "integer",
      "default": 150,
      "maximum": 600,
      "minimum": 5,
      "description": "Seconds the village waits after start-up for every seat's soul file before day 1 begins. A seat still missing its soul at the deadline is reported as a player failure."
     },
     "soulConnectionRequired": {
      "type": "boolean",
      "default": false,
      "description": "When true a seat whose socket drops after its soul was accepted is reported as a player failure. Off by default: the game keeps playing the gnome."
     }
    },
    "additionalProperties": false
   },
