--- a/examples/pudge_wars/game.nim
+++ b/examples/pudge_wars/game.nim
@@ -208,6 +208,15 @@ proc parseGameOptions(): GameOptions =
       result.addHumanSlot(argument[8 .. ^1])
     elif argument == "--duel":
       result.duel = true
+    elif argument == "--offseats" or argument.startsWith("--offseats="):
+      let spec =
+        if argument == "--offseats": arguments.argumentValue(index, "--offseats")
+        else: argument[11 .. ^1]
+      for part in spec.split(','):
+        let seat = parseInt32(part.strip, "--offseats")
+        if seat < 0 or seat >= PudgeCount:
+          fail("--offseats seats are 0-" & $(PudgeCount - 1))
+        result.offSeats.add seat
     elif argument == "--duellog":
       result.matchLogDir = arguments.argumentValue(index, "--duellog")
     elif argument.startsWith("--duellog="):
@@ -414,6 +423,10 @@ proc parseGameOptions(): GameOptions =
     let
       bots = result.botGroups.botCount
       humans = result.humanSlots.len
+    if result.offSeats.len > 0:
+      ## Off seats still take a bot entry (it is dropped at compaction),
+      ## so the count check is against the full board.
+      discard
     if bots != seats and bots + humans != seats:
       fail(
         "live games need bots for all " & $seats &
@@ -704,6 +717,20 @@ proc rebuildWithRoster*() =
   run.botAimNoise = max(options.botAimNoise, 0'i32)
   loadBots(run, activeBotGroups())
 
+proc applyOffSeats*() =
+  ## `--offseats a,b`: switch seats off from the command line, using the
+  ## host lobby's compaction so the board runs with fewer butchers
+  ## (a 2v2 is seats 2 and 5 off). No-op for replays and duels.
+  if options.offSeats.len == 0 or run.replayMode or options.duel:
+    return
+  var disabled: array[PudgeCount, bool]
+  for seat in options.offSeats:
+    disabled[int(seat)] = true
+  setRosterExperiment(disabled)
+  rebuildWithRoster()
+  for slot in options.humanSlots:
+    run.humanSlots.add int(slot)
+
