   "docs": {
    "pages": [
     {
      "id": "rules.md",
      "title": "rules.md",
      "content": {
       "type": "text",
       "value": "# Meadow Rules\n\nN players share one stock that regrows logistically each round unless it ever drops below the collapse threshold \u2014 then it is dead forever. Each round every player simultaneously harvests 0..max_harvest; over-demand splits the remainder pro-rata. Your score is everything you harvest, minus sanction costs you pay and burns you receive. The sustainable aggregate is about regrowth_rate * capacity / 4 per round \u2014 under defaults, roughly one unit per player. Institutional dials (public ledger, sanctions, posted norm text, chat) vary by league variant."
      }
     }
    ],
    "readme": {
     "type": "uri",
     "value": "https://github.com/Metta-AI/coworld-meadow/blob/main/src/coworld/examples/meadow/README.md"
    }
   },
