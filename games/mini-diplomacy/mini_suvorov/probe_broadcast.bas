      promisedTarget(t) = 0
    next t
  end if
end if

if finalCampaign then
  for c = 1 to 7
    if active(c) then
      active(c) = 0
    end if
    pending$(c) = ""
    previousPeace$(c) = ""
  next c
end if

if round = 0 then
  if phase() = 0 then
    for c = 1 to 7
      previousPeace$(c) = ""
      if active(c) = 0 then
        call peaceText(c)
        if pending$(c) = "PRP (" + peace$ + ")" then previousPeace$(c) = pending$(c)
        pending$(c) = ""
      end if
    next c
  end if
  for u = 0 to nu - 1
    lockedKind(u) = -1
    askedDonor(u) = 0
  next u
  for c = 1 to 7
    withdrawn(c) = 0
    asked(c) = 0
    baitOffered(c) = 0
    lastProposal$(c) = ""
    lastAnswer$(c) = ""
  next c
end if

' Process only authenticated private envelopes, never broadcast peace claims.
readNow = 0
while mailboxCount() > 0 and readNow < 32
  readNow = readNow + 1
  raw$ = pullMailbox$()
  senderSeat = mailboxId()
  sender = 0
  for c = 1 to 7
    if countrySeat(c) = senderSeat then sender = c
  next c
  if mailboxChannel() = selfPlayer() and sender > 0 and sender <> me then
    call normalize(raw$)
    if parsed then
      withdrawCampaign = finalCampaign
      if withdrawn(sender) then finalCampaign = 1
      messagePeace = active(sender)
      call handleMessage()
      if messagePeace and active(sender) = 0 then newPeace = 1
      finalCampaign = withdrawCampaign
    end if
  end if
wend
if round = 0 then sent = sendChat(-2, "PRP (PCE (ENG FRA ITA GER AUS TUR RUS))")

if round = 0 then
  if phase() = 0 then
    if version >= 4 then
      call forecastBoard()
    else
      call geometry()
    end if
    call considerWithdrawal()
    if version = 1 then
      call simpleForecast()
    else
      call planMovement()
    end if
  else
    call planAdjustments()
  end if
end if

if phase() = 0 then
  if round > 0 then call considerWithdrawal()
  if (newPeace or withdrawChanged) and round > 0 then
    call geometry()
    call planMovement()
    for a = 0 to ns - 1
      u = own(a)
      if lockedKind(u) >= 0 then
        ok(u) = lockedKind(u)
        ot(u) = lockedTarget(u)
        os(u) = lockedSource(u)
      end if
    next a
  end if
  call honorPeace()
  if round = 0 then
    if peaceMode and finalCampaign = 0 then call offerPeace()
    if version <= 3 and tick = 0 then
      for peer = 1 to 7
        if peer <> me then call send(peer, "TRY (PRP XDO)")
      next peer
    end if
    call requestSupport()
    if version >= 5 then call vacancyBait()
  end if
  for c = 1 to 7
    oldActive(c) = active(c)
  next c
end if

if phase() = 0 then call checkConvoys()

if phase() = 0 and year() = 1901 then call openingBook()
if phase() = 0 and year() = 1902 and me = 3 then call italyBook()

if phase() = 2 then
  for b = 0 to buildSlots - 1
    if chosen(b) >= 0 then result = chooseOrder(chosen(b))
  next b
else
  for a = 0 to ns - 1
    u = own(a)
    if phase() = 0 or ur(u) then
      orderVia = 0
      if phase() = 0 and ok(u) = 1 then orderVia = ov(u)
      result = order(u, ok(u), ot(u), os(u), orderVia)
    end if
  next a
end if
end

sub distance(kind, origin, target)
  distanceValue = d(kind * 6724 + origin * 82 + target) - 1
  if distanceValue < 0 then distanceValue = 99
end sub

sub canReach(u, target)
  reachable = g(uk(u) * 6724 + ut(u) * 82 + parent(target))
end sub

sub isAllowed(target)
  allowed = 1
  if active(owner(parent(target))) then allowed = 0
  if at(target) >= 0 then
    if active(uc(at(target))) then allowed = 0
  else
    if supply(parent(target)) then allowed = 1
  end if
end sub

sub position(country, kind, origin, target, treaty)
  positionValue = 0.0
  p = parent(target)
  if supply(p) and owner(p) <> country then positionValue = 4.0
  if at(target) >= 0 and parent(target) <> parent(origin) then positionValue = positionValue - 3
  if p <> parent(origin) and supply(parent(origin)) and owner(parent(origin)) = country and season() = 1 then positionValue = positionValue - 0.5
  nearest = 99.0
  if potentialWeight > 0 then
  for ci = 0 to centerTotal - 1
    center = centers(ci)
    if owner(parent(center)) <> country and (forecastMode or parent(center) <> p) then
      permitted = 1
      if treaty then
        call isAllowed(center)
        permitted = allowed
      end if
      if permitted then
        call distance(kind, target, center)
        cd = distanceValue
        if at(center) >= 0 then
          if uc(at(center)) <> country then cd = cd + 1.5
        end if
        if cd < nearest then nearest = cd
      end if
    end if
  next ci
  end if
  if nearest < 99 then positionValue = positionValue + potentialWeight / (1 + nearest)
  if treaty and active(owner(p)) and supply(p) and at(target) >= 0 then positionValue = positionValue - 4
end sub

sub value(u, target)
  call position(me, uk(u), ut(u), target, 1)
  valueResult = positionValue
  dest = parent(target)
  origin = parent(ut(u))
  if supply(dest) and owner(dest) <> me and (active(owner(dest)) = 0 or at(target) < 0) then valueResult = valueResult + captureWeight
  ' Retaking an own center held by an enemy is worth a capture and more; we retake 0.1% of moves against the leaders' 1.5%.
  if supply(dest) and owner(dest) = me and at(target) >= 0 then
    if uc(at(target)) <> me then valueResult = valueResult + captureWeight + 12
  end if
  if target <> ut(u) then
    if forecastMode and supply(origin) and owner(origin) <> me and season() = 1 then valueResult = valueResult - 16
    if at(target) >= 0 then
      if uc(at(target)) = me then valueResult = valueResult + 3
    end if
    if supply(origin) and owner(origin) = me then valueResult = valueResult - defenseWeight * threats(origin)
    valueResult = valueResult - forecastWeight * incoming(dest)
    if forecastMode = 0 then
      call priceStall(u, target)
      valueResult = valueResult - stallPrice
    end if
    if supply(dest) and owner(dest) = me and at(target) < 0 and threats(dest) > 0 then valueResult = valueResult + 24
  end if
end sub

sub nextNoise(scale)
  if forecastMode then
    forecastState = forecastState * 1664525 + 1013904223
    noise = ((forecastState and 16383) / 16384) * scale
  else
    noise = (random(10001) / 10000) * scale
  end if
end sub

sub geometry()
  for t = 1 to 81
    marked(t) = 0
    threats(t) = 0
    moveThreats(t) = 0
    for c = 1 to 7
      strength(c * 81 + t - 1) = 0
    next c
  next t
  for enemy = 0 to nu - 1
    if uc(enemy) <> me and ur(enemy) = 0 then
      for ej = 0 to neighborCount(uk(enemy) * 82 + ut(enemy)) - 1
        target = parent(neighbors((uk(enemy) * 82 + ut(enemy)) * 12 + ej))
        if marked(target) <> enemy + 1 then
          marked(target) = enemy + 1
          moveThreats(target) = moveThreats(target) + 1
          strength(uc(enemy) * 81 + target - 1) = strength(uc(enemy) * 81 + target - 1) + 1
          if earnedDefense = 0 or active(uc(enemy)) = 0 or honored(uc(enemy)) = 0 or breached(uc(enemy)) > 0 then threats(target) = threats(target) + 1
        end if
      next ej
    end if
  next enemy
end sub

sub ownUnits()
  ns = 0
  for u = 0 to nu - 1
    if uc(u) = me and ur(u) = 0 then
      own(ns) = u
      ns = ns + 1
    end if
  next u
end sub

sub simpleForecast()
  for t = 1 to 81
    reserved(t) = 0
  next t
  for a = 0 to ns - 1
    actor = own(a)
    ok(actor) = 0
    ot(actor) = 0
    os(actor) = 0
    call position(me, uk(actor), ut(actor), ut(actor), 0)
    simpleValue = positionValue + 0.1
    for aj = 0 to neighborCount(uk(actor) * 82 + ut(actor)) - 1
      target = neighbors((uk(actor) * 82 + ut(actor)) * 12 + aj)
      if reserved(parent(target)) = 0 then
        call position(me, uk(actor), ut(actor), target, 0)
        call nextNoise(1)
        if positionValue + noise > simpleValue then
          simpleValue = positionValue + noise
          ok(actor) = 1
          ot(actor) = target
        end if
      end if
    next aj
    target = ut(actor)
    if ok(actor) = 1 then target = ot(actor)
    reserved(parent(target)) = 1
  next a
  for a = 0 to ns - 1
    donor = own(a)
    if ok(donor) = 0 then
      for b = 0 to ns - 1
        actor = own(b)
        if ok(actor) = 1 then
          call canReach(donor, ot(actor))
          if reachable then
            ok(donor) = 3
            ot(donor) = parent(ot(actor))
            os(donor) = parent(ut(actor))
            exit for
          end if
        end if
      next b
    end if
  next a
end sub

sub forecastBoard()
  observer = me
  for gi = 0 to 101
    guessCountry(gi) = 0
  next gi
  for c = 1 to 7
    savedActive(c) = active(c)
    active(c) = 0
  next c
  for t = 1 to 81
    incoming(t) = 0
  next t
  forecastMode = 1
  forecastWeight = 0
  distinctDonor = 0
  reinforceMode = 0
  idleMode = 0
  for forecastCountry = 1 to 7
    if forecastCountry <> observer then
      me = forecastCountry
      call ownUnits()
      call geometry()
      chosenModel = 2
      modelFit = -1.0
      for model = 0 to 2
        fit = (modelMatches(me * 3 + model) + 1) / (modelObserved(me) + 2)
        if model = 2 then fit = fit + 0.001
        if fit > modelFit then
          modelFit = fit
          chosenModel = model
        end if
      next model
      for model = 0 to 2
        forecastState = 81713 + (year() - 1901) * 262 + season() * 131 + me * 7919 + model * 17
        potentialWeight = 9
        captureWeight = 12
        defenseWeight = 16
        if model = 2 then defenseWeight = 8
        if model = 0 then
          potentialWeight = 0
          captureWeight = 0
          defenseWeight = 0
          call simpleForecast()
        else
          call planMovement()
        end if
        for a = 0 to ns - 1
          actor = own(a)
          gi = model * 34 + actor
          guessCountry(gi) = me
          guessOrigin(gi) = ut(actor)
          guessKind(gi) = ok(actor)
          guessTarget(gi) = ot(actor)
          guessSource(gi) = os(actor)
          if model = chosenModel then
            predicted(actor) = ut(actor)
            if ok(actor) = 1 then
              predicted(actor) = ot(actor)
              incoming(parent(ot(actor))) = incoming(parent(ot(actor))) + 1
            end if
          end if
        next a
      next model
    end if
  next forecastCountry
  me = observer
  potentialWeight = 9
  captureWeight = 12
  defenseWeight = 4
  forecastWeight = 0
  if version >= 12 then forecastWeight = 8
  distinctDonor = 0
  reinforceMode = 0
  idleMode = 0
  if version >= 8 then distinctDonor = 1
  if version >= 9 then reinforceMode = 1
  if version >= 10 then idleMode = 1
  forecastMode = 0
  for c = 1 to 7
    active(c) = savedActive(c)
  next c
  call ownUnits()
  call geometry()
end sub

sub addOffer(actor, target, donor, vacate, score)
  if forecastMode = 0 and donor >= 0 then
    assaultVictim = at(target)
    if assaultVictim >= 0 then
      assaultCountry = uc(assaultVictim)
      if assaultCountry <> me then
        if strength(assaultCountry * 81 + parent(target) - 1) = 0 then score = score + 8
      end if
    end if
  end if
  if forecastMode = 0 and donor >= 0 then
    call priceStall(actor, target)
    score = score + stallPrice
  end if
  fa(nf) = actor
  ft(nf) = target
  fd(nf) = donor
  fv(nf) = vacate
  fs(nf) = score
  rawWeight(nf) = score
  if forecastMode = 0 and donor >= 0 then rawWeight(nf) = score + cost
  nf = nf + 1
end sub

sub planMovement()
  nf = 0
  for t = 1 to 81
    reserved(t) = 0
  next t
  for a = 0 to ns - 1
    actor = own(a)
    used(actor) = 0
    picked(actor) = -1
    ov(actor) = 0
    ok(actor) = 0
    ot(actor) = 0
    os(actor) = 0
    call value(actor, ut(actor))
    h(actor) = valueResult
    best(actor) = h(actor)
    v(actor * 82 + ut(actor)) = h(actor)
    for aj = 0 to neighborCount(uk(actor) * 82 + ut(actor)) - 1
      target = neighbors((uk(actor) * 82 + ut(actor)) * 12 + aj)
      if d(uk(actor) * 6724 + ut(actor) * 82 + target) = 2 then
        call value(actor, target)
        v(actor * 82 + target) = valueResult
        call isAllowed(target)
        if allowed and valueResult > best(actor) then best(actor) = valueResult
      end if
    next aj
  next a
  for a = 0 to ns - 1
    actor = own(a)
    holdOffer = h(actor) + 0.1
    if forecastMode = 0 then holdOffer = 0.1
    call addOffer(actor, ut(actor), -1, -1, holdOffer)
    for aj = 0 to neighborCount(uk(actor) * 82 + ut(actor)) - 1
      target = neighbors((uk(actor) * 82 + ut(actor)) * 12 + aj)
      if d(uk(actor) * 6724 + ut(actor) * 82 + target) = 2 then
        call nextNoise(0.15)
        call isAllowed(target)
        if allowed then
          baseValue = v(actor * 82 + target) + noise
          if forecastMode = 0 then baseValue = baseValue - h(actor)
          victim = at(target)
          friendlyVictim = 0
          if victim >= 0 then friendlyVictim = uc(victim) = me
          if victim < 0 and (forecastMode or incoming(parent(target)) = 0) then
            call addOffer(actor, target, -1, -1, baseValue)
          elseif friendlyVictim then
            call addOffer(actor, target, -1, victim, baseValue)
          else
            donor = -1
            cost = 1000.0
            for b = 0 to ns - 1
              other = own(b)
              call canReach(other, target)
              if other <> actor and reachable then
                alternative = best(other)
                if distinctDonor then
                alternative = h(other)
                for dj = 0 to neighborCount(uk(other) * 82 + ut(other)) - 1
                  dest = neighbors((uk(other) * 82 + ut(other)) * 12 + dj)
                  if parent(dest) <> parent(target) and d(uk(other) * 6724 + ut(other) * 82 + dest) = 2 then
                    call isAllowed(dest)
                    if allowed and v(other * 82 + dest) > alternative then alternative = v(other * 82 + dest)
                  end if
                next dj
                end if
                loss = alternative - h(other)
                if loss < cost then
                  cost = loss
                  donor = other
                end if
              end if
            next b
            if donor >= 0 then
              call addOffer(actor, target, donor, -1, baseValue - cost + forecastWeight * incoming(parent(target)))
            else
              call addOffer(actor, target, -1, -1, baseValue - 2)
            end if
          end if
        end if
      end if
    next aj
  next a
  ' A stable max-heap bounds priority selection to O(n log n).
  heapCount = 0
  for f = 0 to nf - 1
    hi = heapCount
    heap(hi) = f
    heapCount = heapCount + 1
    while hi > 0
      hp = (hi - 1) \ 2
      if fs(heap(hi)) > fs(heap(hp)) then
        swap = heap(hi)
        heap(hi) = heap(hp)
        heap(hp) = swap
        hi = hp
      else
        goto heapUpDone
      end if
    wend
heapUpDone:
  next f
  for iteration = 0 to nf - 1
    take = heap(0)
    heapCount = heapCount - 1
    heap(0) = heap(heapCount)
    hi = 0
    while hi * 2 + 1 < heapCount
      hc = hi * 2 + 1
      if hc + 1 < heapCount then
        if fs(heap(hc + 1)) > fs(heap(hc)) or (fs(heap(hc + 1)) = fs(heap(hc)) and heap(hc + 1) < heap(hc)) then hc = hc + 1
      end if
      if fs(heap(hc)) > fs(heap(hi)) or (fs(heap(hc)) = fs(heap(hi)) and heap(hc) < heap(hi)) then
        swap = heap(hi)
        heap(hi) = heap(hc)
        heap(hc) = swap
        hi = hc
      else
        goto heapDownDone
      end if
    wend
heapDownDone:
    if take >= 0 then
      fs(take) = -2000.0
      actor = fa(take)
      target = ft(take)
      donor = fd(take)
      vacate = fv(take)
      eligible = used(actor) = 0 and reserved(parent(target)) = 0
      if donor >= 0 then
        if used(donor) or reserved(parent(ut(donor))) then eligible = 0
      end if
      if vacate >= 0 then
        if used(vacate) = 0 or ok(vacate) <> 1 then eligible = 0
      end if
      if eligible then
        used(actor) = 1
        picked(actor) = take
        reserved(parent(target)) = 1
        if target <> ut(actor) then
          ok(actor) = 1
          ot(actor) = target
        end if
        if donor >= 0 then
          used(donor) = 1
          picked(donor) = take
          reserved(parent(ut(donor))) = 1
          ok(donor) = 3
          ot(donor) = parent(target)
          os(donor) = parent(ut(actor))
        end if
      end if
    end if
  next iteration
  if forecastMode = 0 then call improvePlans()
  if forecastMode = 0 then call followPlans()
  if forecastMode = 0 then call chainPlans()
  if forecastMode = 0 then call convoyPlans()
  if forecastMode = 0 then call relayPlans()
  ' Reinforce attacks with remaining holds, then defend threatened stationary units.
  if reinforceMode then
  for a = 0 to ns - 1
    donor = own(a)
    if ok(donor) = 0 then
      supportScore = -1000
      for b = 0 to ns - 1
        actor = own(b)
        if actor <> donor and ok(actor) = 1 then
          target = parent(ot(actor))
          call canReach(donor, target)
          if reachable and moveThreats(target) > 0 then
            score = 10 * moveThreats(target) + 100 * supply(target)
            if score > supportScore then
              supportScore = score
              ok(donor) = 3
              ot(donor) = target
              os(donor) = parent(ut(actor))
            end if
          end if
        end if
      next b
    end if
  next a
  end if
  if idleMode then
  for a = 0 to ns - 1
    donor = own(a)
    if ok(donor) = 0 then
      supportScore = -1
      for b = 0 to ns - 1
        actor = own(b)
        if actor <> donor and ok(actor) <> 1 then
          target = parent(ut(actor))
          call canReach(donor, target)
          if reachable then
            attack = 0
            for c = 1 to 7
              if c <> me and (earnedDefense = 0 or active(c) = 0 or honored(c) = 0 or breached(c) > 0) then
                if strength(c * 81 + target - 1) > attack then attack = strength(c * 81 + target - 1)
              end if
            next c
            defense = 1
            for j = 0 to ns - 1
              if ok(own(j)) = 2 and ot(own(j)) = target then defense = defense + 1
            next j
            if attack > defense then
              score = 10 + 10 * (attack - defense)
              if supply(target) then
                score = 500 + 10 * (attack - defense)
                if owner(target) = me then score = score + 500
              end if
              if score > supportScore then
                supportScore = score
                ok(donor) = 2
                ot(donor) = target
                os(donor) = 0
              end if
            end if
          end if
        end if
      next b
    end if
  next a
  end if
end sub

sub improvePlans()
  repairCount = 0
  for repairPass = 0 to 1
    for repairOffer = 0 to nf - 1
      repairTried(repairOffer) = 0
    next repairOffer
    for repairAttempt = 0 to 23
      repairBest = -1
      repairValue = 0
      for repairOffer = 0 to nf - 1
        if fd(repairOffer) >= 0 and fv(repairOffer) < 0 and repairTried(repairOffer) = 0 then
          if picked(fa(repairOffer)) <> repairOffer and rawWeight(repairOffer) > repairValue then
            repairBest = repairOffer
            repairValue = rawWeight(repairOffer)
          end if
        end if
      next repairOffer
      if repairBest < 0 then exit for
      repairTried(repairBest) = 1
      repairActor = fa(repairBest)
      repairDonor = fd(repairBest)
      repairTarget = parent(ft(repairBest))
      for repairOffer = 0 to nf - 1
        repairAffected(repairOffer) = 0
      next repairOffer
      repairOld = picked(repairActor)
      if repairOld >= 0 then repairAffected(repairOld) = 1
      repairOld = picked(repairDonor)
      if repairOld >= 0 then repairAffected(repairOld) = 1
      for repairIndex = 0 to ns - 1
        repairUnit = own(repairIndex)
        repairOld = picked(repairUnit)
        if repairOld >= 0 then
          if fa(repairOld) = repairUnit then
            repairConflict = parent(ft(repairOld)) = repairTarget
            if parent(ft(repairOld)) = parent(ut(repairDonor)) then repairConflict = 1
            if fd(repairOld) >= 0 then
              if parent(ut(fd(repairOld))) = repairTarget then repairConflict = 1
            end if
            if repairConflict then repairAffected(repairOld) = 1
          end if
        end if
      next repairIndex
      repairCost = 0
      repairAllowed = 1
      for repairIndex = 0 to ns - 1
        repairUnit = own(repairIndex)
        repairOld = picked(repairUnit)
        if repairOld >= 0 then
          if fa(repairOld) = repairUnit then
            if repairAffected(repairOld) then
              repairCost = repairCost + rawWeight(repairOld)
            elseif fv(repairOld) >= 0 then
              repairVictim = fv(repairOld)
              repairDependency = picked(repairVictim)
              if repairDependency >= 0 and repairVictim <> repairActor then
                if repairAffected(repairDependency) then repairAllowed = 0
              end if
            end if
          end if
        end if
      next repairIndex
      if repairAllowed and repairValue > repairCost + 0.15 then
        for repairIndex = 0 to ns - 1
          repairUnit = own(repairIndex)
          repairOld = picked(repairUnit)
          if repairOld >= 0 then
            if repairAffected(repairOld) then
              picked(repairUnit) = -1
              ok(repairUnit) = 0
              ot(repairUnit) = 0
              os(repairUnit) = 0
            end if
          end if
        next repairIndex
        picked(repairActor) = repairBest
        ok(repairActor) = 1
        ot(repairActor) = ft(repairBest)
        os(repairActor) = 0
        picked(repairDonor) = repairBest
        ok(repairDonor) = 3
        ot(repairDonor) = repairTarget
        os(repairDonor) = parent(ut(repairActor))
        repairCount = repairCount + 1
      end if
    next repairAttempt
  next repairPass
end sub

sub followPlans()
  followCount = 0
  for followPass = 0 to 2
    for followIndex = 0 to ns - 1
      followActor = own(followIndex)
      followCurrent = picked(followActor)
      followOwner = followActor
      followEligible = 1
      if lockedKind(followActor) >= 0 then followEligible = 0
      followValue = 0
      if followCurrent >= 0 then
        followOwner = fa(followCurrent)
        followValue = rawWeight(followCurrent)
        if followOwner <> followActor then
          if lockedKind(followOwner) >= 0 then followEligible = 0
          for followOtherIndex = 0 to ns - 1
            followOther = own(followOtherIndex)
            if followOther <> followOwner and followOther <> followActor and ok(followOther) = 1 then
              if parent(ot(followOther)) = parent(ut(followOwner)) then followEligible = 0
            end if
          next followOtherIndex
        end if
        if fd(followCurrent) >= 0 then
          if lockedKind(fd(followCurrent)) >= 0 then followEligible = 0
        end if
      end if
      if followEligible then
        followBest = -1
        followMinimum = followValue + 0.15
        for followOffer = 0 to nf - 1
          if fa(followOffer) = followActor and fd(followOffer) < 0 then
            if ft(followOffer) <> ut(followActor) and rawWeight(followOffer) > followMinimum and rawWeight(followOffer) > followValue then
              followAllowed = 1
              followVictim = fv(followOffer)
              if followVictim >= 0 then
                followKind = ok(followVictim)
                followDestination = ot(followVictim)
                if lockedKind(followVictim) >= 0 then
                  followKind = lockedKind(followVictim)
                  followDestination = lockedTarget(followVictim)
                end if
                if followKind <> 1 then followAllowed = 0
                if parent(followDestination) = parent(ut(followActor)) then followAllowed = 0
              end if
              if followAllowed then
                followTarget = parent(ft(followOffer))
                for followOtherIndex = 0 to ns - 1
                  followOther = own(followOtherIndex)
                  if followOther <> followActor then
                    followDestination = parent(ut(followOther))
                    if followOther <> followOwner then
                      followKind = ok(followOther)
                      followPlannedTarget = ot(followOther)
                      if lockedKind(followOther) >= 0 then
                        followKind = lockedKind(followOther)
                        followPlannedTarget = lockedTarget(followOther)
                      end if
                      if followKind = 1 then followDestination = parent(followPlannedTarget)
                    end if
                    if followDestination = followTarget then followAllowed = 0
                  end if
                next followOtherIndex
              end if
              if followAllowed then
                followBest = followOffer
                followValue = rawWeight(followOffer)
              end if
            end if
          end if
        next followOffer
        if followBest >= 0 then
          if followCurrent >= 0 then
            if followOwner <> followActor then
              picked(followOwner) = -1
              ok(followOwner) = 0
              ot(followOwner) = 0
              os(followOwner) = 0
            else
              followDonor = fd(followCurrent)
              if followDonor >= 0 then
                picked(followDonor) = -1
                ok(followDonor) = 0
                ot(followDonor) = 0
                os(followDonor) = 0
              end if
            end if
          end if
          picked(followActor) = followBest
          ok(followActor) = 1
          ot(followActor) = ft(followBest)
          os(followActor) = 0
          followCount = followCount + 1
        end if
      end if
    next followIndex
  next followPass
end sub

sub chainPlans()
  ' Improve disjoint two-move chains while preserving existing coverage.
  chainCount = 0
  for chainIndex = 0 to ns - 1
    chainUsed(own(chainIndex)) = 0
  next chainIndex
  for chainPass = 0 to 3
    chainBest = -1
    chainSecond = -1
    chainGain = 0.15
    for chainOffer = 0 to nf - 1
      chainActor = fa(chainOffer)
      chainMover = fv(chainOffer)
      if chainMover >= 0 and fd(chainOffer) < 0 then
        chainEligible = chainUsed(chainActor) = 0 and chainUsed(chainMover) = 0
        if lockedKind(chainActor) >= 0 or lockedKind(chainMover) >= 0 then chainEligible = 0
        chainCost = 0
        chainOld = picked(chainActor)
        if chainOld >= 0 then
          if fa(chainOld) <> chainActor or fd(chainOld) >= 0 then chainEligible = 0
          chainCost = chainCost + rawWeight(chainOld)
        end if
        chainOld = picked(chainMover)
        if chainOld >= 0 then
          if fa(chainOld) <> chainMover or fd(chainOld) >= 0 then chainEligible = 0
          chainCost = chainCost + rawWeight(chainOld)
        end if
        if chainEligible then
          chainRefund = 0
          chainOrigin = parent(ut(chainMover))
          if ok(chainActor) = 1 and ok(chainMover) = 1 then
            if parent(ot(chainActor)) = chainOrigin then chainCost = chainCost + chainRefund
          end if
          for chainNext = 0 to nf - 1
            if fa(chainNext) = chainMover and fd(chainNext) < 0 and ft(chainNext) <> ut(chainMover) then
              chainTarget = parent(ft(chainNext))
              chainValue = rawWeight(chainOffer) + rawWeight(chainNext) + chainRefund - chainCost
              if chainValue > chainGain and chainTarget <> parent(ut(chainActor)) and chainTarget <> chainOrigin then
                chainAllowed = 1
                chainVictim = fv(chainNext)
                if chainVictim >= 0 then
                  chainKind = ok(chainVictim)
                  chainDestination = ot(chainVictim)
                  if lockedKind(chainVictim) >= 0 then
                    chainKind = lockedKind(chainVictim)
                    chainDestination = lockedTarget(chainVictim)
                  end if
                  if chainKind <> 1 or parent(chainDestination) = chainOrigin then chainAllowed = 0
                elseif at(ft(chainNext)) >= 0 then
                  chainAllowed = 0
                end if
                if chainAllowed then
                  for chainIndex = 0 to ns - 1
                    chainOther = own(chainIndex)
                    if chainOther <> chainActor and chainOther <> chainMover then
                      chainDestination = parent(ut(chainOther))
                      chainKind = ok(chainOther)
                      chainPlannedTarget = ot(chainOther)
                      if lockedKind(chainOther) >= 0 then
                        chainKind = lockedKind(chainOther)
                        chainPlannedTarget = lockedTarget(chainOther)
                      end if
                      if chainKind = 1 then chainDestination = parent(chainPlannedTarget)
                      if chainDestination = chainOrigin or chainDestination = chainTarget then chainAllowed = 0
                    end if
                  next chainIndex
                end if
                if chainAllowed then
                  chainBest = chainOffer
                  chainSecond = chainNext
                  chainGain = chainValue
                end if
              end if
            end if
          next chainNext
        end if
      end if
    next chainOffer
    if chainBest < 0 then exit for
    chainActor = fa(chainBest)
    chainMover = fa(chainSecond)
    picked(chainActor) = chainBest
    picked(chainMover) = chainSecond
    ok(chainActor) = 1
    ot(chainActor) = ft(chainBest)
    os(chainActor) = 0
    ok(chainMover) = 1
    ot(chainMover) = ft(chainSecond)
    os(chainMover) = 0
    chainUsed(chainActor) = 1
    chainUsed(chainMover) = 1
    chainCount = chainCount + 1
  next chainPass
end sub

sub convoyPlans()
  for relayReset = 0 to 33
    relayArmy(relayReset) = 0
    for relayResetBoat = 0 to 33
      relayMembers(relayReset * 34 + relayResetBoat) = 0
    next relayResetBoat
  next relayReset
  ' Compare direct single-fleet convoys with the displaced single orders.
  convoyCount = 0
  for convoyIndex = 0 to ns - 1
    convoyUsed(own(convoyIndex)) = 0
  next convoyIndex
  for convoyPass = 0 to 3
    convoyBestArmy = -1
    convoyBestBoat = -1
    convoyBestLanding = 0
    convoyGain = 0.15
    for convoyChoice = 0 to choiceCount() - 1
      if choiceKind(convoyChoice) = 4 then
        convoyBoat = choiceUnit(convoyChoice)
        convoyOrigin = choiceSource(convoyChoice)
        convoyLanding = choiceTarget(convoyChoice)
        convoyArmy = at(convoyOrigin)
        if convoyArmy >= 0 then
          if uc(convoyArmy) = me and uk(convoyArmy) = 0 then
            convoyEligible = convoyUsed(convoyArmy) = 0 and convoyUsed(convoyBoat) = 0
            if lockedKind(convoyArmy) >= 0 or lockedKind(convoyBoat) >= 0 then convoyEligible = 0
            if at(convoyLanding) >= 0 or incoming(convoyLanding) > 0 then convoyEligible = 0
            if g(6724 + ut(convoyBoat) * 82 + convoyOrigin) = 0 then convoyEligible = 0
            if g(6724 + ut(convoyBoat) * 82 + convoyLanding) = 0 then convoyEligible = 0
            convoyCost = 0
            convoyOld = picked(convoyArmy)
            if convoyOld >= 0 then
              if fa(convoyOld) <> convoyArmy or fd(convoyOld) >= 0 then convoyEligible = 0
              convoyCost = convoyCost + rawWeight(convoyOld)
            end if
            convoyOld = picked(convoyBoat)
            if convoyOld >= 0 then
              if fa(convoyOld) <> convoyBoat or fd(convoyOld) >= 0 then convoyEligible = 0
              convoyCost = convoyCost + rawWeight(convoyOld)
            end if
            if convoyEligible then
              call isAllowed(convoyLanding)
              if allowed then
                call value(convoyArmy, convoyLanding)
                convoyValue = valueResult - h(convoyArmy) - convoyCost
                if convoyValue > convoyGain then
                  convoyAllowed = 1
                  for convoyIndex = 0 to ns - 1
                    convoyOther = own(convoyIndex)
                    if convoyOther <> convoyArmy and convoyOther <> convoyBoat then
                      convoyDestination = parent(ut(convoyOther))
                      convoyKind = ok(convoyOther)
                      convoyPlannedTarget = ot(convoyOther)
                      if lockedKind(convoyOther) >= 0 then
                        convoyKind = lockedKind(convoyOther)
                        convoyPlannedTarget = lockedTarget(convoyOther)
                      end if
                      if convoyKind = 1 then convoyDestination = parent(convoyPlannedTarget)
                      if convoyDestination = convoyLanding or convoyDestination = parent(ut(convoyBoat)) then convoyAllowed = 0
                    end if
                  next convoyIndex
                  if convoyAllowed then
                    convoyBestArmy = convoyArmy
                    convoyBestBoat = convoyBoat
                    convoyBestLanding = convoyLanding
                    convoyGain = convoyValue
                  end if
                end if
              end if
            end if
          end if
        end if
      end if
    next convoyChoice
    if convoyBestArmy < 0 then exit for
    picked(convoyBestArmy) = -1
    picked(convoyBestBoat) = -1
    ok(convoyBestArmy) = 1
    ot(convoyBestArmy) = convoyBestLanding
    os(convoyBestArmy) = 0
    ov(convoyBestArmy) = 1
    convoyFleet(convoyBestArmy) = convoyBestBoat
    convoyTarget(convoyBestArmy) = convoyBestLanding
    ok(convoyBestBoat) = 4
    ot(convoyBestBoat) = convoyBestLanding
    os(convoyBestBoat) = parent(ut(convoyBestArmy))
    convoyUsed(convoyBestArmy) = 1
    convoyUsed(convoyBestBoat) = 1
    convoyCount = convoyCount + 1
  next convoyPass
end sub

sub checkConvoys()
  call checkRelays()
  ' Cancel an unsupported voyage after a later diplomatic commitment.
  for convoyIndex = 0 to ns - 1
    convoyArmy = own(convoyIndex)
    if ov(convoyArmy) and relayArmy(convoyArmy) = 0 then
      if ok(convoyArmy) <> 1 or ot(convoyArmy) <> convoyTarget(convoyArmy) then
        ov(convoyArmy) = 0
      else
        convoyBoat = convoyFleet(convoyArmy)
        if ok(convoyBoat) <> 4 or ot(convoyBoat) <> convoyTarget(convoyArmy) or os(convoyBoat) <> parent(ut(convoyArmy)) then
          ov(convoyArmy) = 0
          ok(convoyArmy) = 0
          ot(convoyArmy) = 0
          os(convoyArmy) = 0
        end if
      end if
    end if
  next convoyIndex
end sub

sub observeStall(stallHistory)
  ' Retain independent bounded failure counts for each unit type and route.
  stallOrigin = parent(historyOrigin(stallHistory))
  stallDestination = parent(historyTarget(stallHistory))
  stallKey = historyUnitType(stallHistory) * 6724 + stallOrigin * 82 + stallDestination
  stallUnit = at(stallOrigin)
  stallOccupied = at(stallDestination)
  stallEnemy = 0
  if stallOccupied >= 0 then stallEnemy = uc(stallOccupied)
  stallStayed = 0
  if stallUnit >= 0 then
    if uc(stallUnit) = me and ur(stallUnit) = 0 and uk(stallUnit) = historyUnitType(stallHistory) then stallStayed = 1
  end if
  if stallEnemy = me or stallStayed = 0 then
    stallCount(stallKey) = 0
  elseif historyOccupantCountry(stallDestination) <> me then
    if stallCountry(stallKey) <> stallEnemy then stallCount(stallKey) = 0
    stallCountry(stallKey) = stallEnemy
    if stallCount(stallKey) < 4 then stallCount(stallKey) = stallCount(stallKey) + 1
  end if
end sub

sub priceStall(stallActor, stallLanding)
  ' Price each blocked route independently and refund support as before.
  stallPrice = 0
  stallFrom = parent(ut(stallActor))
  stallTo = parent(stallLanding)
  stallKey = uk(stallActor) * 6724 + stallFrom * 82 + stallTo
  if stallTo <> stallFrom then
    stallDefender = 0
    stallOccupant = at(stallLanding)
    if stallOccupant >= 0 then stallDefender = uc(stallOccupant)
    if stallDefender = stallCountry(stallKey) and stallDefender <> me then
      if stallDefender > 0 or incoming(stallTo) > 0 then stallPrice = 6 * stallCount(stallKey)
    end if
  end if
  if supply(stallTo) and owner(stallTo) = me then stallPrice = 0
end sub

sub relayPlans()
  ' Search own sea fleets with bounded nonnegative displaced-plan costs.
  relayBestArmy = -1
  relayBestLanding = 0
  relayBestGain = 0.15
  for relayIndex = 0 to ns - 1
    relayBoat = own(relayIndex)
    relayEligible(relayBoat) = 0
    relayBestPath(relayBoat) = 0
    for relayLanding = 0 to 81
      relayLandings(relayBoat * 82 + relayLanding) = 0
    next relayLanding
    if uk(relayBoat) = 1 and ut(relayBoat) >= 51 and ut(relayBoat) <= 69 then
      if convoyUsed(relayBoat) = 0 and lockedKind(relayBoat) < 0 then
        relayEligible(relayBoat) = 1
        relayCost(relayBoat) = 0.05
        relayOld = picked(relayBoat)
        if relayOld >= 0 then
          if fa(relayOld) <> relayBoat or fd(relayOld) >= 0 then relayEligible(relayBoat) = 0
          if rawWeight(relayOld) > 0 then relayCost(relayBoat) = relayCost(relayBoat) + rawWeight(relayOld)
        end if
      end if
    end if
  next relayIndex
  for relayChoice = 0 to choiceCount() - 1
    if choiceKind(relayChoice) = 1 and choiceViaConvoy(relayChoice) then
      relayActor = choiceUnit(relayChoice)
      relayLanding = choiceTarget(relayChoice)
      relayLandings(relayActor * 82 + relayLanding) = 1
    end if
  next relayChoice
  for relayArmyIndex = 0 to ns - 1
    relayActor = own(relayArmyIndex)
    relayAllowed = uk(relayActor) = 0 and convoyUsed(relayActor) = 0 and lockedKind(relayActor) < 0
    relayArmyCost = 0
    relayOld = picked(relayActor)
    if relayOld >= 0 then
      if fa(relayOld) <> relayActor or fd(relayOld) >= 0 then relayAllowed = 0
      if rawWeight(relayOld) > 0 then relayArmyCost = rawWeight(relayOld)
    end if
    if relayAllowed then
      for relayIndex = 0 to ns - 1
        relayBoat = own(relayIndex)
        relayDist(relayBoat) = 10000
        relayPrev(relayBoat) = -1
        relayDone(relayBoat) = 0
        if relayEligible(relayBoat) then
          if g(6724 + ut(relayBoat) * 82 + parent(ut(relayActor))) then relayDist(relayBoat) = relayCost(relayBoat)
        end if
      next relayIndex
      for relayStep = 0 to ns - 1
        relayFrom = -1
        relayMinimum = 10000
        for relayIndex = 0 to ns - 1
          relayBoat = own(relayIndex)
          if relayEligible(relayBoat) and relayDone(relayBoat) = 0 and relayDist(relayBoat) < relayMinimum then
            relayMinimum = relayDist(relayBoat)
            relayFrom = relayBoat
          end if
        next relayIndex
        if relayFrom < 0 then exit for
        relayDone(relayFrom) = 1
        for relayIndex = 0 to ns - 1
          relayBoat = own(relayIndex)
          if relayEligible(relayBoat) and relayDone(relayBoat) = 0 then
            if g(6724 + ut(relayFrom) * 82 + parent(ut(relayBoat))) then
              relayDistance = relayMinimum + relayCost(relayBoat)
              if relayDistance < relayDist(relayBoat) then
                relayDist(relayBoat) = relayDistance
                relayPrev(relayBoat) = relayFrom
              end if
            end if
          end if
        next relayIndex
      next relayStep
      for relayLanding = 1 to 81
        if relayLandings(relayActor * 82 + relayLanding) then
          relayAllowed = at(relayLanding) < 0 and incoming(relayLanding) = 0
          call isAllowed(relayLanding)
          if allowed = 0 then relayAllowed = 0
          if relayAllowed then
            call value(relayActor, relayLanding)
            relayValue = valueResult - h(relayActor) - relayArmyCost
            for relayEndIndex = 0 to ns - 1
              relayEnd = own(relayEndIndex)
              if relayEligible(relayEnd) and relayDist(relayEnd) < 10000 then
                if g(6724 + ut(relayEnd) * 82 + parent(relayLanding)) then
                  relayGain = relayValue - relayDist(relayEnd)
                  if relayGain > relayBestGain then
                    for relayIndex = 0 to ns - 1
                      relayPath(own(relayIndex)) = 0
                    next relayIndex
                    relayLength = 0
                    relayBoat = relayEnd
                    for relayStep = 0 to ns - 1
                      if relayBoat < 0 then exit for
                      relayPath(relayBoat) = 1
                      relayLength = relayLength + 1
                      relayBoat = relayPrev(relayBoat)
                    next relayStep
                    relayAllowed = relayBoat < 0 and relayLength >= 2
                    for relayIndex = 0 to ns - 1
                      relayOther = own(relayIndex)
                      if relayOther <> relayActor and relayPath(relayOther) = 0 then
                        relayDestination = parent(ut(relayOther))
                        relayKind = ok(relayOther)
                        relayTarget = ot(relayOther)
                        if lockedKind(relayOther) >= 0 then
                          relayKind = lockedKind(relayOther)
                          relayTarget = lockedTarget(relayOther)
                        end if
                        if relayKind = 1 then relayDestination = parent(relayTarget)
                        if relayDestination = parent(relayLanding) then relayAllowed = 0
                        for relayBoatIndex = 0 to ns - 1
                          relayBoat = own(relayBoatIndex)
                          if relayPath(relayBoat) and relayDestination = parent(ut(relayBoat)) then relayAllowed = 0
                        next relayBoatIndex
                      end if
                    next relayIndex
                    if relayAllowed then
                      relayBestArmy = relayActor
                      relayBestLanding = relayLanding
                      relayBestGain = relayGain
                      for relayIndex = 0 to ns - 1
                        relayBoat = own(relayIndex)
                        relayBestPath(relayBoat) = relayPath(relayBoat)
                      next relayIndex
                    end if
                  end if
                end if
              end if
            next relayEndIndex
          end if
        end if
      next relayLanding
    end if
  next relayArmyIndex
  if relayBestArmy >= 0 then
    picked(relayBestArmy) = -1
    ok(relayBestArmy) = 1
    ot(relayBestArmy) = relayBestLanding
    os(relayBestArmy) = 0
    ov(relayBestArmy) = 1
    relayArmy(relayBestArmy) = 1
    convoyTarget(relayBestArmy) = relayBestLanding
    convoyUsed(relayBestArmy) = 1
    for relayIndex = 0 to ns - 1
      relayBoat = own(relayIndex)
      if relayBestPath(relayBoat) then
        picked(relayBoat) = -1
        ok(relayBoat) = 4
        ot(relayBoat) = relayBestLanding
        os(relayBoat) = parent(ut(relayBestArmy))
        convoyUsed(relayBoat) = 1
        relayMembers(relayBestArmy * 34 + relayBoat) = 1
      end if
    next relayIndex
    convoyCount = convoyCount + 1
  end if
end sub

sub checkRelays()
  ' Cancel a voyage when any required own fleet changes its commitment.
  for relayIndex = 0 to ns - 1
    relayActor = own(relayIndex)
    if ov(relayActor) and relayArmy(relayActor) then
      if ok(relayActor) <> 1 or ot(relayActor) <> convoyTarget(relayActor) then
        ov(relayActor) = 0
      else
        relayBroken = 0
        for relayBoatIndex = 0 to ns - 1
          relayBoat = own(relayBoatIndex)
          if relayMembers(relayActor * 34 + relayBoat) then
            if ok(relayBoat) <> 4 or ot(relayBoat) <> convoyTarget(relayActor) or os(relayBoat) <> parent(ut(relayActor)) then relayBroken = 1
          end if
        next relayBoatIndex
        if relayBroken then
          ov(relayActor) = 0
          ok(relayActor) = 0
          ot(relayActor) = 0
          os(relayActor) = 0
        end if
      end if
    end if
  next relayIndex
end sub

sub reachBuild(kind, origin)
  ' Measure reachable eligible centers without changing the movement planner.
  for buildTerritory = 1 to 81
    buildReach(buildTerritory) = 0
  next buildTerritory
  for buildCi = 0 to centerTotal - 1
    buildSite = centers(buildCi)
    if owner(parent(buildSite)) <> me then
      buildAllowed = 1
      if buildTreaty then
        call isAllowed(buildSite)
        buildAllowed = allowed
      end if
      if buildAllowed then
        call distance(kind, origin, buildSite)
        if distanceValue < 99 then
          buildPotential = 9 / (1 + distanceValue)
          if buildPotential > buildReach(parent(buildSite)) then buildReach(parent(buildSite)) = buildPotential
        end if
      end if
    end if
  next buildCi
end sub

sub coverBuild(kind, origin)
  ' Include an existing unit or an already selected build in current coverage.
  call reachBuild(kind, origin)
  for buildTerritory = 1 to 81
    if buildReach(buildTerritory) > buildCover(buildTerritory) then buildCover(buildTerritory) = buildReach(buildTerritory)
  next buildTerritory
end sub

sub prepareBuilds()
  ' Initialize bounded coverage from public positions of our existing units.
  for buildTerritory = 1 to 81
    buildCover(buildTerritory) = 0
  next buildTerritory
  for buildIndex = 0 to ns - 1
    buildUnit = own(buildIndex)
    if ur(buildUnit) = 0 then call coverBuild(uk(buildUnit), ut(buildUnit))
  next buildIndex
end sub

sub marginalBuild(kind, origin)
  ' Reward new access while retaining the existing nearest-center value.
  call reachBuild(kind, origin)
  buildGain = 0
  for buildTerritory = 1 to 81
    if buildReach(buildTerritory) > buildCover(buildTerritory) then buildGain = buildGain + buildReach(buildTerritory) - buildCover(buildTerritory)
  next buildTerritory
end sub

sub planAdjustments()
  slots = buildCount()
  buildTreaty = 1
  if 1908 > 0 and year() >= 1908 - 2 then buildTreaty = 0
  if phase() = 2 and slots > 0 then call prepareBuilds()
  if phase() = 2 and slots < 0 then
    call geometry()
    for removalIndex = 0 to ns - 1
      removalUnit = own(removalIndex)
      removalOrigin = parent(ut(removalUnit))
      call position(me, uk(removalUnit), ut(removalUnit), ut(removalUnit), 0)
      keepValue(removalUnit) = positionValue
      if supply(removalOrigin) and owner(removalOrigin) = me then
        keepValue(removalUnit) = keepValue(removalUnit) + defenseWeight * threats(removalOrigin)
      end if
    next removalIndex
  end if
  buildSlots = slots
  if slots < 0 then buildSlots = -slots
  for t = 1 to 81
    reserved(t) = 0
  next t
  for a = 0 to ns - 1
    ok(own(a)) = 6
    ot(own(a)) = 0
    os(own(a)) = 0
  next a
  maxSlot = nu
  if phase() = 2 then maxSlot = buildSlots
  for slot = 0 to maxSlot - 1
    bestChoice = -1
    choiceValue = -1000.0
    for i = 0 to choiceCount() - 1
      if choiceUnit(i) = slot then
        kind = choiceKind(i)
        target = choiceTarget(i)
        candidate = -999.0
        if kind = 5 and reserved(parent(target)) = 0 then
          call position(me, uk(slot), ut(slot), target, 0)
          candidate = positionValue + random(10001) / 10000
        elseif (kind = 7 or kind = 8) and reserved(parent(target)) = 0 then
          call position(me, kind - 7, target, target, buildTreaty)
          call marginalBuild(kind - 7, target)
          candidate = positionValue + buildGain + random(10001) / 10000
        elseif kind = 6 or kind = 10 then
          candidate = -998.0
        elseif kind = 9 and reserved(parent(target)) = 0 then
          removalUnit = at(target)
          if removalUnit >= 0 then candidate = -keepValue(removalUnit)
        end if
        if candidate > choiceValue then
          choiceValue = candidate
          bestChoice = i
        end if
      end if
    next i
    chosen(slot) = bestChoice
    if bestChoice >= 0 then
      target = choiceTarget(bestChoice)
      reserved(parent(target)) = 1
      if phase() = 2 and slots > 0 then
        buildKind = choiceKind(bestChoice)
        if buildKind = 7 or buildKind = 8 then call coverBuild(buildKind - 7, target)
      end if
      if phase() <> 2 then
        ok(slot) = choiceKind(bestChoice)
        ot(slot) = target
      end if
    end if
  next slot
end sub

sub send(peer, text$)
  sent = 0
  if sentNow < 32 and len(text$) <= 1024 then
    sent = sendChat(countrySeat(peer), text$)
    if sent then sentNow = sentNow + 1
  end if
end sub

sub peaceText(peer)
  if me < peer then
    peace$ = "PCE (" + power$(me) + " " + power$(peer) + ")"
  else
    peace$ = "PCE (" + power$(peer) + " " + power$(me) + ")"
  end if
end sub

sub considerWithdrawal()
  ' Withdraw one alliance for distinct immediate autumn opportunities.
  withdrawChanged = 0
  withdrawMinimum = 1
  withdrawDeficit = 2
  if phase() <> 0 or season() <> 1 or finalCampaign then exit sub
  for withdrawPeer = 1 to 7
    if withdrawn(withdrawPeer) then exit sub
  next withdrawPeer
  withdrawOwn = centerCount(me)
  withdrawLeader = withdrawOwn
  for withdrawPeer = 1 to 7
    if centerCount(withdrawPeer) > withdrawLeader then withdrawLeader = centerCount(withdrawPeer)
  next withdrawPeer
  if withdrawLeader - withdrawOwn < withdrawDeficit then exit sub
  call geometry()
  withdrawBest = 0
  withdrawBestSize = 0
  for withdrawPeer = 1 to 7
    withdrawSize = centerCount(withdrawPeer)
    if withdrawPeer <> me and active(withdrawPeer) and withdrawSize >= withdrawOwn then
      withdrawCount = 0
      withdrawFirst = -1
      withdrawFirstTarget = 0
      for withdrawIndex = 0 to ns - 1
        withdrawUnit = own(withdrawIndex)
        withdrawOrigin = parent(ut(withdrawUnit))
        withdrawEligible = ur(withdrawUnit) = 0 and lockedKind(withdrawUnit) < 0
        if supply(withdrawOrigin) then
          if owner(withdrawOrigin) <> me or threats(withdrawOrigin) > 0 then withdrawEligible = 0
        end if
        if withdrawEligible then
          for withdrawTarget = 1 to 81
            if parent(withdrawTarget) = withdrawTarget and supply(withdrawTarget) and owner(withdrawTarget) = withdrawPeer and at(withdrawTarget) < 0 then
              call canReach(withdrawUnit, withdrawTarget)
              if reachable then
                if withdrawFirst < 0 then
                  withdrawFirst = withdrawUnit
                  withdrawFirstTarget = withdrawTarget
                  withdrawCount = 1
                elseif withdrawUnit <> withdrawFirst then
                  if withdrawTarget <> withdrawFirstTarget then
                    withdrawCount = 2
                  else
                    for withdrawAlternate = 1 to 81
                      if withdrawAlternate <> withdrawFirstTarget and parent(withdrawAlternate) = withdrawAlternate and supply(withdrawAlternate) and owner(withdrawAlternate) = withdrawPeer and at(withdrawAlternate) < 0 then
                        call canReach(withdrawFirst, withdrawAlternate)
                        if reachable then
                          withdrawCount = 2
                          exit for
                        end if
                      end if
                    next withdrawAlternate
                  end if
                end if
                if withdrawCount >= withdrawMinimum then exit for
              end if
            end if
          next withdrawTarget
        end if
        if withdrawCount >= withdrawMinimum then exit for
      next withdrawIndex
      if withdrawCount >= withdrawMinimum and withdrawSize > withdrawBestSize then
        withdrawBest = withdrawPeer
        withdrawBestSize = withdrawSize
      end if
    end if
  next withdrawPeer
  if withdrawBest > 0 then
    call peaceText(withdrawBest)
    call send(withdrawBest, "FCT (NAR (" + peace$ + "))")
    if sent then
      active(withdrawBest) = 0
      pending$(withdrawBest) = ""
      withdrawn(withdrawBest) = 1
      withdrawChanged = 1
      call geometry()
    end if
  end if
end sub

sub offerPeace()
  slots = 0
  chosenPeer = 0
  leastOffers = 10000
  proximity = 99
  smallPower = 1000
  for c = 1 to 7
    if active(c) or pending$(c) <> "" then slots = slots + 1
    crooked = promises(c) >= 2 and promises(c) - kept(c) >= 2
    if c <> me and withdrawn(c) = 0 and active(c) = 0 and pending$(c) = "" and breached(c) = 0 and centerCount(c) > 0 and crooked = 0 then
      near = 99
      units = 0
      for t = 1 to 81
        powerReach(t) = 0.0
      next t
      for j = 0 to nu - 1
        if uc(j) = c then
          units = units + 1
          if ur(j) = 0 then
            for pj = 0 to neighborCount(uk(j) * 82 + ut(j)) - 1
              target = parent(neighbors((uk(j) * 82 + ut(j)) * 12 + pj))
              if supply(target) and owner(target) <> c then
                reachValue = 0.75
                if at(target) >= 0 then reachValue = 0.25
                if reachValue > powerReach(target) then powerReach(target) = reachValue
              end if
            next pj
          end if
          for a = 0 to ns - 1
            call distance(uk(own(a)), ut(own(a)), ut(j))
            if distanceValue < near then near = distanceValue
          next a
        end if
      next j
      power = 4 * centerCount(c) + units
      for t = 1 to 75
        power = power + powerReach(t)
      next t
      if units > 0 then
        if offered(c) < leastOffers or (offered(c) = leastOffers and (near < proximity or (near = proximity and power < smallPower))) then
          chosenPeer = c
          leastOffers = offered(c)
          proximity = near
          smallPower = power
        end if
      end if
    end if
  next c
  if ns > 0 then
    for c = 1 to 7
      crooked = promises(c) >= 2 and promises(c) - kept(c) >= 2
      if c <> me and withdrawn(c) = 0 and active(c) = 0 and pending$(c) = "" and breached(c) = 0 and centerCount(c) > 0 and crooked = 0 then
        call peaceText(c)
        text$ = "PRP (" + peace$ + ")"
        call send(c, text$)
        if sent then
          pending$(c) = text$
          offered(c) = offered(c) + 1
        end if
      end if
    next c
  end if
end sub

sub unitText(u)
  type$ = "AMY"
  if uk(u) = 1 then type$ = "FLT"
  unit$ = "(" + power$(uc(u)) + " " + type$ + " " + loc$(ut(u)) + ")"
end sub

sub actionText(u, kind, target, source)
  call unitText(u)
  action$ = "(" + unit$ + " HLD)"
  if kind = 1 then action$ = "(" + unit$ + " MTO " + loc$(target) + ")"
  if kind = 2 or kind = 3 then
    carrier = at(source)
    if kind = 2 then carrier = at(target)
    if carrier >= 0 then
      donor$ = unit$
      call unitText(carrier)
      action$ = "(" + donor$ + " SUP " + unit$
      if kind = 3 then action$ = action$ + " MTO " + loc$(target)
      action$ = action$ + ")"
    end if
  end if
end sub

sub requestSupport()
  for peer = 1 to 7
    asked(peer) = 0
  next peer
  for a = 0 to ns - 1
    actor = own(a)
    if ok(actor) = 1 then
      victim = at(ot(actor))
      victimCountry = 0
      if victim >= 0 then victimCountry = uc(victim)
      for donor = 0 to nu - 1
        peer = uc(donor)
        requestEligible = peer <> me and peer <> victimCountry and askedDonor(donor) = 0
        if version >= 4 then
          if predicted(donor) <> ut(donor) then requestEligible = 0
        else
          if victimCountry = 0 or victimCountry = me or asked(peer) then requestEligible = 0
        end if
        if requestEligible then
          call canReach(donor, ot(actor))
          if reachable then
            call actionText(donor, 3, parent(ot(actor)), parent(ut(actor)))
            call send(peer, "PRP (XDO " + action$ + ")")
            if sent then
              askedDonor(donor) = 1
              asked(peer) = 1
            end if
          end if
        end if
      next donor
    end if
  next a
end sub

sub vacancyBait()
  for a = 0 to ns - 1
    actor = own(a)
    if ok(actor) = 0 or ok(actor) = 1 then
      for rival = 0 to nu - 1
        peer = uc(rival)
        call canReach(actor, ut(rival))
        baitLanding = 0
        for landingIndex = 0 to neighborCount(uk(actor) * 82 + ut(actor)) - 1
          landing = neighbors((uk(actor) * 82 + ut(actor)) * 12 + landingIndex)
          if parent(landing) = parent(ut(rival)) then baitLanding = landing
        next landingIndex
        if baitLanding = 0 then reachable = 0
        reliable = promises(peer) >= 3 and (kept(peer) + 1) / (promises(peer) + 2) >= 0.8 and attacksUs(peer) <= 1
        susceptible = baitAttempts(peer) = 0 or (baitDuped(peer) + 1) / (baitAttempts(peer) + 2) >= 0.6
        if promises(peer) >= 2 and promises(peer) - kept(peer) >= 2 then susceptible = 1
        if peer <> me and active(peer) = 0 and baitOffered(peer) = 0 and reliable = 0 and susceptible and reachable and supply(parent(ut(rival))) and predicted(rival) = ut(rival) then
          for bj = 0 to neighborCount(uk(rival) * 82 + ut(rival)) - 1
            target = neighbors((uk(rival) * 82 + ut(rival)) * 12 + bj)
            call canReach(actor, target)
            if d(uk(rival) * 6724 + ut(rival) * 82 + target) = 2 and reachable and supply(target) = 0 and at(target) < 0 and owner(target) <> peer then
              call actionText(rival, 1, target, 0)
              move$ = action$
              call actionText(actor, 3, target, parent(ut(rival)))
              text$ = "PRP (AND (XDO " + move$ + ") (XDO " + action$ + "))"
              call send(peer, text$)
              if sent then
                baitOffered(peer) = 1
                baitAttempts(peer) = baitAttempts(peer) + 1
                baitAccepted(peer) = 0
                baitOrigin(peer) = parent(ut(rival))
                baitDestination(peer) = parent(target)
                baitText$(peer) = text$
                baitActor(peer) = actor
                baitTarget(peer) = baitLanding
                baitTick(peer) = tick
              end if
              exit for
            end if
          next bj
        end if
      next rival
    end if
  next a
end sub

sub honorPeace()
  for a = 0 to ns - 1
    u = own(a)
    stopped(u) = 0
    if ok(u) = 1 or ok(u) = 3 then
      victim = at(ot(u))
      hostile = active(owner(parent(ot(u))))
      if victim >= 0 then hostile = hostile or active(uc(victim))
      if victim < 0 and supply(parent(ot(u))) then hostile = 0
      if ok(u) = 3 and at(os(u)) >= 0 then
        if active(uc(at(os(u)))) then hostile = 0
      end if
      if hostile then
        stopped(u) = 1
        ok(u) = 0
        ot(u) = 0
        os(u) = 0
      end if
    end if
  next a
  for a = 0 to ns - 1
    u = own(a)
    if ok(u) = 3 and at(os(u)) >= 0 then
      carrier = at(os(u))
      if uc(carrier) = me and stopped(carrier) then
        ok(u) = 0
        ot(u) = 0
        os(u) = 0
        call canReach(u, ut(carrier))
        if reachable then
          ok(u) = 2
          ot(u) = parent(ut(carrier))
        end if
      end if
    end if
  next a
end sub
' Recover formatting, then validate every supported arrangement and order.
sub normalize(raw$)
  parsed = 0
  call stripText(ucase$(raw$))
  text$ = stripped$
  if left$(text$, 3) = "```" then
    text$ = mid$(text$, 4)
    if left$(text$, 5) = "DAIDE" then text$ = mid$(text$, 6)
    call stripText(text$)
    text$ = stripped$
  end if
  if left$(text$, 1) = "`" or left$(text$, 1) = chr$(34) then text$ = mid$(text$, 2)
  if left$(text$, 11) = "UNDERSTOOD." then text$ = trim$(mid$(text$, 12))
  for c = 1 to 7
    name$ = ucase$(countryName$(c)) + ":"
    if left$(text$, len(name$)) = name$ then text$ = trim$(mid$(text$, len(name$) + 1))
  next c
  legacy$ = "FRM (" + power$(sender) + " " + power$(me) + "):"
  if left$(text$, len(legacy$)) = legacy$ then text$ = trim$(mid$(text$, len(legacy$) + 1))
  if left$(text$, 1) = "(" and right$(text$, 1) = ")" then text$ = trim$(mid$(text$, 2, len(text$) - 2))
  call stripText(text$)
  text$ = stripped$
  head$ = left$(text$, 3)
  if head$ = "DEC" then
    text$ = "REJ" + mid$(text$, 4)
    head$ = "REJ"
  end if
  if head$ <> "PRP" and head$ <> "YES" and head$ <> "REJ" and head$ <> "FCT" and head$ <> "CCL" and head$ <> "XDO" and head$ <> "PCE" and head$ <> "AND" then exit sub
  depth = 0
  began = 0
  stopAt = 0
  for pos = 4 to len(text$)
    char$ = mid$(text$, pos, 1)
    if char$ = "(" then
      depth = depth + 1
      began = 1
    elseif char$ = ")" then
      depth = depth - 1
      if depth < 0 then exit sub
      if began and depth = 0 then
        stopAt = pos
        exit for
      end if
    end if
  next pos
  if began = 0 then exit sub
  if stopAt = 0 then
    if depth < 1 or depth > 2 then exit sub
    text$ = text$ + string$(depth, ")")
    stopAt = len(text$)
  end if
  call stripText(mid$(text$, stopAt + 1))
  suffix$ = stripped$
  text$ = left$(text$, stopAt)
  if left$(suffix$, 4) = "AND " and head$ = "PRP" then
    text$ = "PRP (AND " + mid$(text$, 5) + " " + trim$(mid$(suffix$, 5)) + ")"
  else
    if left$(suffix$, 1) = ")" then exit sub
    if instr(suffix$, "PRP (") or instr(suffix$, "YES (") or instr(suffix$, "REJ (") or instr(suffix$, "PCE (") or instr(suffix$, "XDO (") then exit sub
  end if
  if head$ = "XDO" or head$ = "PCE" or head$ = "AND" then text$ = "PRP (" + text$ + ")"
  if head$ = "YES" or head$ = "REJ" then
    body$ = trim$(mid$(text$, 6, len(text$) - 6))
    if left$(body$, 3) <> "PRP" then text$ = head$ + " (PRP (" + body$ + "))"
  end if
  call tokenize(text$)
  if tokenError then exit sub
  parsed = 1
end sub

sub stripText(input$)
  firstByte = 1
  lastByte = len(input$)
  while firstByte <= lastByte
    if asc(mid$(input$, firstByte, 1)) > 32 then goto leftTrimmed
    firstByte = firstByte + 1
  wend
leftTrimmed:
  while lastByte >= firstByte
    if asc(mid$(input$, lastByte, 1)) > 32 then goto rightTrimmed
    lastByte = lastByte - 1
  wend
rightTrimmed:
  stripped$ = mid$(input$, firstByte, lastByte - firstByte + 1)
end sub

sub tokenize(text$)
  nt = 0
  sp = 0
  wordStart = 0
  tokenError = 0
  if len(text$) > 512 then
    tokenError = 1
    exit sub
  end if
  for pos = 1 to len(text$) + 1
    char$ = " "
    if pos <= len(text$) then char$ = mid$(text$, pos, 1)
    if char$ = "(" or char$ = ")" or asc(char$) <= 32 then
      if wordStart > 0 then
        call token(mid$(text$, wordStart, pos - wordStart))
        wordStart = 0
      end if
      if char$ = "(" or char$ = ")" then call token(char$)
    else
      if wordStart = 0 then wordStart = pos
    end if
    if tokenError then exit sub
  next pos
  if sp <> 0 then tokenError = 1
end sub

sub token(word$)
  if nt >= 128 then
    tokenError = 1
    exit sub
  end if
  nt = nt + 1
  tk$(nt) = word$
  mate(nt) = 0
  if word$ = "(" then
    if sp >= 32 then
      tokenError = 1
      exit sub
    end if
    stack(sp) = nt
    sp = sp + 1
  elseif word$ = ")" then
    if sp = 0 then
      tokenError = 1
      exit sub
    end if
    sp = sp - 1
    mate(stack(sp)) = nt
  end if
end sub

sub renderTokens()
  canonical$ = ""
  for ti = 1 to nt
    if ti > 1 and tk$(ti) <> ")" and tk$(ti - 1) <> "(" then canonical$ = canonical$ + " "
    canonical$ = canonical$ + tk$(ti)
  next ti
end sub

sub readLocation()
  location = 0
  location$ = tk$(pi)
  if location$ = "ENG" then
    tk$(pi) = "ECH"
    location$ = "ECH"
  end if
  if location$ = "BOT" then
    tk$(pi) = "GOB"
    location$ = "GOB"
  end if
  if location$ = "LYO" then
    tk$(pi) = "GOL"
    location$ = "GOL"
  end if
  if location$ = "(" then
    if mate(pi) <> pi + 3 then
      valid = 0
      exit sub
    end if
    if tk$(pi + 1) = "BUL" and tk$(pi + 2) = "NCS" then tk$(pi + 2) = "ECS"
    location$ = "(" + tk$(pi + 1) + " " + tk$(pi + 2) + ")"
    pi = pi + 4
  else
    pi = pi + 1
  end if
  for li = 1 to 81
    if loc$(li) = location$ then location = li
  next li
  if location = 0 then valid = 0
end sub

sub readUnit()
  parsedUnit = -1
  if tk$(pi) <> "(" then
    valid = 0
    exit sub
  end if
  unitEnd = mate(pi)
  unitPower = 0
  for ui = 1 to 7
    if tk$(pi + 1) = power$(ui) then unitPower = ui
  next ui
  pi = pi + 2
  if tk$(pi) = "A" or tk$(pi) = "ARMY" then tk$(pi) = "AMY"
  if tk$(pi) = "F" or tk$(pi) = "FLEET" then tk$(pi) = "FLT"
  unitKind = -1
  if tk$(pi) = "AMY" then unitKind = 0
  if tk$(pi) = "FLT" then unitKind = 1
  pi = pi + 1
  call readLocation()
  if pi <> unitEnd then valid = 0
  for ui = 0 to nu - 1
    if uc(ui) = unitPower and uk(ui) = unitKind and ut(ui) = location then parsedUnit = ui
  next ui
  if parsedUnit < 0 then valid = 0
  pi = pi + 1
end sub

sub readOrder(start)
  if nr >= 16 then
    valid = 0
    exit sub
  end if
  orderEnd = mate(start)
  pi = start + 1
  call readUnit()
  requestedUnit = parsedUnit
  verb$ = tk$(pi)
  pi = pi + 1
  requestedKind = -1
  requestedTarget = 0
  requestedSource = 0
  if verb$ = "HLD" then
    requestedKind = 0
  elseif verb$ = "MTO" then
    requestedKind = 1
    call readLocation()
    requestedTarget = location
  elseif verb$ = "SUP" then
    call readUnit()
    carriedUnit = parsedUnit
    if carriedUnit >= 0 then
      requestedKind = 2
      requestedTarget = parent(ut(carriedUnit))
      if tk$(pi) = "MTO" then
        pi = pi + 1
        call readLocation()
        requestedKind = 3
        requestedSource = parent(ut(carriedUnit))
        requestedTarget = parent(location)
      end if
    end if
  end if
  if pi <> orderEnd or requestedKind < 0 or requestedUnit < 0 then valid = 0
  if valid then
    if requestedKind = 1 then
      if d(uk(requestedUnit) * 6724 + ut(requestedUnit) * 82 + requestedTarget) <> 2 then valid = 0
    elseif requestedKind = 2 or requestedKind = 3 then
      call canReach(requestedUnit, requestedTarget)
      if reachable = 0 or carriedUnit = requestedUnit then valid = 0
      if requestedKind = 3 then
        if d(uk(carriedUnit) * 6724 + ut(carriedUnit) * 82 + location) <> 2 then valid = 0
      end if
    end if
  end if
  if valid then
    ru(nr) = requestedUnit
    rk(nr) = requestedKind
    rt(nr) = requestedTarget
    rs(nr) = requestedSource
    nr = nr + 1
  end if
end sub

sub arrangement(start)
  if tk$(start) <> "(" or mate(start) = 0 then
    valid = 0
    exit sub
  end if
  arrangementEnd = mate(start)
  if tk$(start + 1) = "XDO" then
    if tk$(start + 2) <> "(" or mate(start + 2) <> arrangementEnd - 1 then
      valid = 0
      exit sub
    end if
    call readOrder(start + 2)
  elseif tk$(start + 1) = "PCE" then
    if mate(start + 2) <> start + 5 or arrangementEnd <> start + 6 then
      valid = 0
      exit sub
    end if
    firstPower = 0
    secondPower = 0
    for ai = 1 to 7
      if tk$(start + 3) = power$(ai) then firstPower = ai
      if tk$(start + 4) = power$(ai) then secondPower = ai
    next ai
    if (firstPower = me and secondPower = sender) or (secondPower = me and firstPower = sender) then
      requestedPeace = sender
    else
      valid = 0
    end if
  elseif tk$(start + 1) = "AND" then
    clause = start + 2
    bound = mate(start)
    ' The current port accepts a flat explicit conjunction, never alternatives.
    while clause < bound and valid
      if tk$(clause + 1) <> "PCE" and tk$(clause + 1) <> "XDO" then
        valid = 0
      else
        nextClause = mate(clause) + 1
        call arrangement(clause)
        clause = nextClause
      end if
    wend
    if clause <> bound then valid = 0
  else
    valid = 0
  end if
end sub

sub handleMessage()
  if nt < 4 or tk$(2) <> "(" or mate(2) <> nt then exit sub
  valid = 1
  nr = 0
  requestedPeace = 0
  root$ = tk$(1)
  start = 2
  if root$ = "YES" or root$ = "REJ" or root$ = "CCL" then
    if tk$(3) <> "PRP" or tk$(4) <> "(" or mate(4) <> nt - 1 then exit sub
    start = 4
  elseif root$ = "FCT" then
    if tk$(3) <> "NAR" and tk$(3) <> "NOT" then exit sub
    if tk$(4) <> "(" or mate(4) <> nt - 1 then exit sub
    start = 4
  elseif root$ <> "PRP" then
    exit sub
  end if
  call arrangement(start)
  if valid = 0 then exit sub
  call renderTokens()
  if requestedPeace then
    if peaceMode = 0 then exit sub
    if root$ = "FCT" then
      active(sender) = 0
      pending$(sender) = ""
      exit sub
    elseif root$ = "CCL" then
      pending$(sender) = ""
      exit sub
    elseif root$ = "YES" or root$ = "REJ" then
      responseMatches = canonical$ = root$ + " (" + pending$(sender) + ")"
      if nr = 0 then
        call peaceText(sender)
        plainPeace$ = "PRP (" + peace$ + ")"
        reversePeace$ = "PRP (PCE (" + power$(sender) + " " + power$(me) + "))"
        if me > sender then reversePeace$ = "PRP (PCE (" + power$(me) + " " + power$(sender) + "))"
        if pending$(sender) = plainPeace$ or previousPeace$(sender) = plainPeace$ then
          if canonical$ = root$ + " (" + plainPeace$ + ")" or canonical$ = root$ + " (" + reversePeace$ + ")" then responseMatches = 1
        end if
      end if
      if responseMatches then
        if root$ = "YES" and finalCampaign = 0 then
          if active(sender) = 0 then newPeace = 1
          active(sender) = 1
        end if
        if root$ = "REJ" then refused(sender) = refused(sender) + 1
        pending$(sender) = ""
        previousPeace$(sender) = ""
      end if
      exit sub
    end if
  end if
  if root$ = "YES" then
    if round > 0 and baitTick(sender) = tick and canonical$ = "YES (" + baitText$(sender) + ")" then
      baitAccepted(sender) = 1
      actor = baitActor(sender)
      call isAllowed(baitTarget(sender))
      if allowed then
        ok(actor) = 1
        ot(actor) = baitTarget(sender)
        os(actor) = 0
      end if
    end if
    exit sub
  end if
  if root$ <> "PRP" or phase() <> 0 then exit sub
  if nr > 0 and round = 0 then exit sub
  accept = 1
  ' Never let another power lock our orders: refuse every proposal carrying order requests.
  if nr > 0 then accept = 0
  if version <= 3 then
    if nr <> 1 or requestedPeace then accept = 0
    if nr = 1 then
      if rk(0) <> 3 or at(rs(0)) < 0 then
        accept = 0
      else
        if uc(at(rs(0))) <> sender then accept = 0
      end if
    end if
  end if
  if requestedPeace then
    if finalCampaign then accept = 0
    slots = 0
    for c = 1 to 7
      if c <> sender and (active(c) or pending$(c) <> "") then slots = slots + 1
    next c
    if slots >= 7 or breached(sender) > 0 or ns = 0 or centerCount(sender) = 0 then accept = 0
    if promises(sender) >= 2 and promises(sender) - kept(sender) >= 2 then accept = 0
  end if
  for a = 0 to ns - 1
    u = own(a)
    updateKind(u) = ok(u)
    updateTarget(u) = ot(u)
    updateSource(u) = os(u)
  next a
  foundOwn = requestedPeace <> 0
  for r = 0 to nr - 1
    u = ru(r)
    if uc(u) = me then
      foundOwn = 1
      if updateKind(u) <> 0 and (updateKind(u) <> rk(r) or updateTarget(u) <> rt(r) or updateSource(u) <> rs(r)) then accept = 0
      if rk(r) = 1 and supply(parent(ut(u))) and supply(parent(rt(r))) = 0 then
        if occupiedGuard or (vacancyGuard and owner(parent(ut(u))) = me) then accept = 0
      end if
      victim = 0
      if rt(r) > 0 then
        victim = owner(parent(rt(r)))
        if at(rt(r)) >= 0 then victim = uc(at(rt(r)))
      end if
      if rk(r) = 1 or rk(r) = 3 then
        if active(victim) then accept = 0
      end if
      if version >= 4 and (ok(u) <> rk(r) or ot(u) <> rt(r) or os(u) <> rs(r)) then
        ' Frozen v4's conservative country priors apply to changed orders.
        if victim = me or victim = 0 then accept = 0
        if sender = 4 or sender = 6 or sender = 7 then accept = 0
      end if
      updateKind(u) = rk(r)
      updateTarget(u) = rt(r)
      updateSource(u) = rs(r)
    end if
  next r
  if foundOwn = 0 then accept = 0
  if canonical$ = lastProposal$(sender) then
    call send(sender, lastAnswer$(sender))
    exit sub
  end if
  answer$ = "REJ (" + canonical$ + ")"
  if accept then answer$ = "YES (" + canonical$ + ")"
  call send(sender, answer$)
  if sent then
    lastProposal$(sender) = canonical$
    lastAnswer$(sender) = answer$
    if accept then
      for a = 0 to ns - 1
        u = own(a)
        ok(u) = updateKind(u)
        ot(u) = updateTarget(u)
        os(u) = updateSource(u)
      next a
      if requestedPeace then
        if active(sender) = 0 then newPeace = 1
        active(sender) = 1
      end if
      for r = 0 to nr - 1
        if uc(ru(r)) = me then
          lockedKind(ru(r)) = rk(r)
          lockedTarget(ru(r)) = rt(r)
          lockedSource(ru(r)) = rs(r)
        end if
        if uc(ru(r)) = sender and rk(r) = 1 then promisedTarget(parent(ut(ru(r)))) = parent(rt(r))
        if rk(r) = 3 and rs(r) > 0 then
          carrier = at(rs(r))
          if carrier >= 0 then
            if uc(carrier) = sender then promisedTarget(parent(ut(carrier))) = parent(rt(r))
          end if
        end if
      next r
    end if
  end if
end sub

sub bookOrder(kind, target, source, via)
  ok(bookUnit) = kind
  ot(bookUnit) = target
  os(bookUnit) = source
  ov(bookUnit) = via
end sub

sub ownAt(t)
  ownHere = 0
  if at(t) >= 0 then
    if uc(at(t)) = me then ownHere = 1
  end if
end sub

' 1901 opening book copied from the public league replays of the top two
' policies. Units standing where the book expects them follow it; any other
' unit keeps the planner's order.
sub openingBook()
  bookSeason = season()
  for a = 0 to ns - 1
    bookUnit = own(a)
    bookOrigin = parent(ut(bookUnit))
    bookArmy = 0
    if uk(bookUnit) = 0 then bookArmy = 1
    if me = 1 then
      if bookSeason = 0 then
        if bookArmy and bookOrigin = 3 then call bookOrder(1, 4, 0, 0)
        if bookArmy = 0 and bookOrigin = 2 then call bookOrder(1, 53, 0, 0)
        if bookArmy = 0 and bookOrigin = 6 then call bookOrder(1, 60, 0, 0)
      else
        if bookArmy and bookOrigin = 4 then
          call ownAt(53)
          if ownHere then call bookOrder(1, 35, 0, 1)
        end if
        if bookArmy = 0 and bookOrigin = 53 then
          call ownAt(4)
          if ownHere then call bookOrder(4, 35, 4, 0)
        end if
        if bookArmy = 0 and bookOrigin = 60 then
          if at(46) < 0 then
            call bookOrder(1, 46, 0, 0)
          else
            call bookOrder(1, 44, 0, 0)
          end if
        end if
        if bookArmy = 0 and bookOrigin = 6 then call bookOrder(1, 60, 0, 0)
      end if
    end if
    if me = 2 then
      if bookSeason = 0 then
        if bookArmy and bookOrigin = 49 then call bookOrder(1, 8, 0, 0)
        if bookArmy and bookOrigin = 47 then call bookOrder(1, 50, 0, 0)
        if bookArmy = 0 and bookOrigin = 46 then call bookOrder(1, 60, 0, 0)
      else
        if bookArmy and bookOrigin = 50 then call bookOrder(1, 8, 0, 0)
        if bookArmy and bookOrigin = 8 then call bookOrder(1, 7, 0, 0)
        if bookArmy = 0 and bookOrigin = 60 then call bookOrder(1, 44, 0, 0)
        if bookArmy = 0 and bookOrigin = 46 then call bookOrder(1, 61, 0, 0)
      end if
    end if
    if me = 3 then
      if bookSeason = 0 then
        if bookArmy and bookOrigin = 12 then call bookOrder(1, 13, 0, 0)
        if bookArmy and bookOrigin = 15 then call bookOrder(0, 0, 0, 0)
        if bookArmy = 0 and bookOrigin = 11 then call bookOrder(1, 65, 0, 0)
      else
        if bookArmy and bookOrigin = 13 then call bookOrder(1, 14, 0, 0)
        if bookArmy and bookOrigin = 15 then call bookOrder(1, 73, 0, 0)
        if bookArmy = 0 and bookOrigin = 65 then call bookOrder(1, 10, 0, 0)
      end if
    end if
    if me = 4 then
      if bookSeason = 0 then
        if bookArmy and bookOrigin = 38 then call bookOrder(1, 37, 0, 0)
        if bookArmy and bookOrigin = 41 then call bookOrder(1, 42, 0, 0)
        if bookArmy = 0 and bookOrigin = 37 then call bookOrder(1, 43, 0, 0)
      else
        if bookArmy and bookOrigin = 37 then call bookOrder(1, 36, 0, 0)
        if bookArmy and bookOrigin = 42 then call bookOrder(1, 44, 0, 0)
        if bookArmy = 0 and bookOrigin = 43 then
          call ownAt(42)
          if ownHere then call bookOrder(3, 44, 42, 0)
        end if
      end if
    end if
    if me = 5 then
      if bookSeason = 0 then
        if bookArmy and bookOrigin = 74 then call bookOrder(1, 19, 0, 0)
        if bookArmy and bookOrigin = 72 then call bookOrder(1, 73, 0, 0)
        if bookArmy = 0 and bookOrigin = 73 then call bookOrder(1, 18, 0, 0)
      else
        if bookArmy = 0 and bookOrigin = 18 then call bookOrder(1, 17, 0, 0)
        if bookArmy and bookOrigin = 19 then
          call ownAt(18)
          if ownHere then
            call bookOrder(3, 17, 18, 0)
          else
            call bookOrder(0, 0, 0, 0)
          end if
        end if
        if bookArmy and bookOrigin = 73 then call bookOrder(0, 0, 0, 0)
      end if
    end if
    if me = 6 then
      if bookSeason = 0 then
        if bookArmy and bookOrigin = 22 then call bookOrder(1, 20, 0, 0)
        if bookArmy and bookOrigin = 23 then call bookOrder(1, 22, 0, 0)
        if bookArmy = 0 and bookOrigin = 24 then call bookOrder(1, 69, 0, 0)
      else
        if bookArmy and bookOrigin = 20 then call bookOrder(1, 17, 0, 0)
        if bookArmy and bookOrigin = 22 then call bookOrder(1, 20, 0, 0)
        if bookArmy = 0 and bookOrigin = 69 then
          call ownAt(22)
          if ownHere then call bookOrder(3, 20, 22, 0)
        end if
      end if
    end if
    if me = 7 then
      if bookSeason = 0 then
        if bookArmy and bookOrigin = 31 then call bookOrder(1, 27, 0, 0)
        if bookArmy and bookOrigin = 29 then call bookOrder(1, 75, 0, 0)
        if bookArmy = 0 and bookOrigin = 27 then call bookOrder(1, 21, 0, 0)
        if bookArmy = 0 and bookOrigin = 32 then call bookOrder(1, 57, 0, 0)
      else
        if bookArmy and bookOrigin = 75 then call bookOrder(1, 74, 0, 0)
        if bookArmy and bookOrigin = 27 then
          call ownAt(21)
          if ownHere then
            call bookOrder(2, 21, 0, 0)
          else
            call bookOrder(1, 21, 0, 0)
          end if
        end if
        if bookArmy = 0 and bookOrigin = 57 then call bookOrder(1, 34, 0, 0)
        if bookArmy = 0 and bookOrigin = 21 then call bookOrder(0, 0, 0, 0)
      end if
    end if
  next a
end sub

' 1902 Italian eastern campaign copied from Wagtail's league replays: Piedmont
' to Tyrolia, Venice to Trieste, Tyrolia on to Trieste or Vienna, Ionian to
' Greece. Units standing elsewhere keep the planner's order.
sub italyBook()
  bookSeason = season()
  call ownAt(73)
  holdTrieste = ownHere
  for a = 0 to ns - 1
    bookUnit = own(a)
    bookOrigin = parent(ut(bookUnit))
    bookArmy = 0
    if uk(bookUnit) = 0 then bookArmy = 1
    if bookSeason = 0 then
      if bookArmy and bookOrigin = 14 then call bookOrder(1, 70, 0, 0)
      if bookArmy and bookOrigin = 73 then
        call ownAt(14)
        if ownHere then call bookOrder(3, 70, 14, 0)
      end if
      if bookArmy and bookOrigin = 15 and holdTrieste = 0 then call bookOrder(1, 73, 0, 0)
      if bookArmy = 0 and bookOrigin = 10 then
        ' Skip the Ionian when another own unit already heads there, to avoid a self-bounce.
        ionianTaken = 0
        for k = 0 to ns - 1
          if own(k) <> bookUnit and ok(own(k)) = 1 and parent(ot(own(k))) = 65 then ionianTaken = 1
        next k
        if ionianTaken = 0 then call bookOrder(1, 65, 0, 0)
      end if
    else
      if bookArmy and bookOrigin = 70 then
        if holdTrieste then
          call bookOrder(1, 72, 0, 0)
        else
          call bookOrder(1, 73, 0, 0)
        end if
      end if
      if bookArmy and bookOrigin = 73 then
        call ownAt(70)
        if ownHere then call bookOrder(3, 72, 70, 0)
      end if
      if bookArmy and bookOrigin = 15 and holdTrieste = 0 then
        call ownAt(70)
        if ownHere then call bookOrder(3, 73, 70, 0)
      end if
      if bookArmy = 0 and bookOrigin = 65 and owner(17) <> me then call bookOrder(1, 17, 0, 0)
    end if
  next a
end sub
